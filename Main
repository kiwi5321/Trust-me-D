    <!-- The Bait Button Box -->
    <div class="bait-container" id="baitBox">
        <h1 style="font-size: 32px; margin-bottom: 20px;">This content requires verification.</h1>
        <button class="trust-btn" onclick="startPrank()">TRUST ME</button>
    </div>

    <!-- The Secret Video Element -->
    <!-- Replace the URL inside src="" with your direct MP4 video link -->
    <video id="prankVideo" loop playsinline src="YOUR_DIRECT_VIDEO_MP4_URL_HERE"></video>

    <script>
        function startPrank() {
            const video = document.getElementById('prankVideo');
            const baitBox = document.getElementById('baitBox');

            // 1. Hide the entry button box
            baitBox.style.display = 'none';

            // 2. Show the full-screen video layer
            video.style.display = 'block';

            // 3. Bypass mobile/browser security by playing directly on user click interaction
            video.play().catch(error => {
                console.log("Playback failed, trying muted autoplay fallback", error);
            });

            // 4. Attempt to trigger system Fullscreen Mode
            if (document.documentElement.requestFullscreen) {
                document.documentElement.requestFullscreen();
            } else if (document.documentElement.webkitRequestFullscreen) { /* Safari */
                document.documentElement.webkitRequestFullscreen();
            }
        }
    </script>
